# ==============================================================================
# SentinelOS Backend Environment Configuration
# ==============================================================================

# Database Configuration (Supabase PostgreSQL)
# Session pooler (Port 5432) or Transaction pooler (Port 6543)
DATABASE_URL=postgresql://postgres.jvdhzinfsaylvuidtqfd:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# JWT Secret Key (Must be at least 32 characters in production)
SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret-key-32-chars

# Environment Mode ('production', 'staging', 'development')
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated list of allowed frontend domains, e.g. Vercel)
CORS_ORIGINS=https://sentinel-os-beta.vercel.app,http://localhost:5173,http://localhost:3000

# Cookie Security
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Token Expiry (Minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Cache & Session Store (Docker service: redis://redis:6379/0 or local: redis://localhost:6379/0)
REDIS_URL=redis://redis:6379/0

# Field Operations & OTP Configuration
FIELD_OTP_EXPIRY_SECONDS=600
FIELD_OTP_MAX_ATTEMPTS=5
FIELD_LOCATION_UPDATE_INTERVAL_SECONDS=10
FIELD_LOCATION_RETENTION_DAYS=90

# Telemetry & OLT Integration Provider ('synthetic', 'snmp_mock')
OLT_PROVIDER=synthetic
OLT_POLL_INTERVAL_SECONDS=60

# Google Maps API (Optional for server-side routing enhancements)
# GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
